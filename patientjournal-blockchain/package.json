{
  "name": "patientjournal-blockchain",
  "version": "1.0.0",
  "description": "Journalsystem där varje åtkomst till en journal registreras i en blockkedja som synkas mellan noder",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "node1": "cross-env PORT=3001 P2P_PORT=6001 node src/server.js",
    "node2": "cross-env PORT=3002 P2P_PORT=6002 PEERS=ws://localhost:6001 node src/server.js",
    "test": "jest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "cross-env": "^10.1.0",
    "express": "^4.22.3",
    "express-session": "^1.19.0",
    "socket.io": "^4.8.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.0"
  },
  "jest": {
    "testEnvironment": "node"
  }
}
